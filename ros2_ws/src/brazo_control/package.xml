<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brazo_control</name>
  <version>0.1.0</version>
  <description>
    Control del brazo robotico del Grupo 3, Taller de Proyecto I (E0306), UNLP.
    Expone la interfaz estandar de un manipulador —la accion
    control_msgs/FollowJointTrajectory— y, por encima, ir a un punto resolviendo
    la cinematica inversa cerrada, memorizar poses y reproducirlas.
  </description>
  <maintainer email="ml3280199@gmail.com">Matias Lopez</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>brazo_interfaces</exec_depend>
  <exec_depend>brazo_description</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
