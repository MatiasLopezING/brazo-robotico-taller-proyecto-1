<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brazo_interfaces</name>
  <version>0.1.0</version>
  <description>
    Interfaces ROS 2 del brazo robotico del Grupo 3, Taller de Proyecto I (E0306),
    UNLP: la accion de ir a un punto y los servicios de consulta de cinematica
    inversa y de memorizar y reproducir poses.
  </description>
  <maintainer email="ml3280199@gmail.com">Matias Lopez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
